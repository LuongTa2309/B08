NETS 17 ;
    - _00_ ( _20_ D ) ( _13_ X ) + USE SIGNAL ;
    - _01_ ( _21_ D ) ( _14_ Y ) + USE SIGNAL ;
    - _02_ ( _22_ D ) ( _18_ X ) + USE SIGNAL ;
    - _03_ ( _23_ D ) ( _19_ X ) + USE SIGNAL ;
    - _04_ ( _14_ B ) ( _12_ A ) ( _10_ Y ) + USE SIGNAL ;
    - _05_ ( _12_ B ) ( _11_ X ) + USE SIGNAL ;
    - _06_ ( _13_ A ) ( _12_ X ) + USE SIGNAL ;
    - _07_ ( _19_ B ) ( _17_ A_N ) ( _15_ X ) + USE SIGNAL ;
    - _08_ ( _17_ B ) ( _16_ X ) + USE SIGNAL ;
    - _09_ ( _18_ A ) ( _17_ X ) + USE SIGNAL ;
    - clk ( PIN clk ) ( _23_ CLK ) ( _22_ CLK ) ( _21_ CLK ) ( _20_ CLK ) + USE SIGNAL ;
    - count[0] ( PIN count[0] ) ( _20_ Q ) ( _16_ A1 ) ( _15_ A ) ( _11_ A ) ( _10_ A ) + USE SIGNAL ;
    - count[1] ( PIN count[1] ) ( _21_ Q ) ( _16_ A2 ) ( _15_ B ) ( _14_ A ) + USE SIGNAL ;
