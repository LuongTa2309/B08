    - count[3] ( PIN count[3] ) ( _23_ Q ) ( _19_ A ) + USE SIGNAL ;
    - en ( PIN en ) ( _16_ A3 ) ( _15_ D ) ( _11_ B ) ( _10_ B ) + USE SIGNAL ;
    - rst_n ( PIN rst_n ) ( _23_ RESET_B ) ( _22_ RESET_B ) ( _21_ RESET_B ) ( _20_ RESET_B ) + USE SIGNAL ;
END NETS
END DESIGN
